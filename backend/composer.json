{
    "name": "seghis/patient-portal",
    "description": "Simplified Patient Portal",
    "type": "project",
    "require": {
        "php": "^8.2",
        "php-di/php-di": "^7.1",
        "firebase/php-jwt": "^7.1",
        "guzzlehttp/guzzle": "^8.0",
        "monolog/monolog": "^3.10",
        "nikic/fast-route": "^1.3",
        "ramsey/uuid": "^4.9",
        "vlucas/phpdotenv": "^5.6",
        "laminas/laminas-diactoros": "^3.8",
        "fruitcake/php-cors": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
